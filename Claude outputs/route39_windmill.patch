 INCLUDE "data/tilesets/league_room_anims.asm"
+
+
+; Route 39 windmill (Moomoo Farm). Art, blocks and run table are generated by
+; tools/build_route39_windmill.py. The sails sweep 32 VRAM-bank-1 tiles; each
+; of the eight frames (11.25 degrees apart) is GDMA'd there in one VBlank, so
+; a frame never shows half old and half new.
+
+INCLUDE "data/tilesets/route39_windmill_runs.asm"
+
+ROUTE39_WINDMILL_FRAME_SIZE EQU ROUTE39_WINDMILL_FRAME_TILES * LEN_2BPP_TILE
+	assert ROUTE39_WINDMILL_FRAME_SIZE == $200, "AnimateRoute39Windmill indexes frames by $200"
+
+Route39WindmillAnim:
+	db LEAGUE_ANIM_WINDMILL
+
+AnimateRoute39Windmill:
+; Show frame (wTileAnimationTimer & 7): the timer steps once per Johto
+; animation cycle (13 VBlanks), so a quarter turn takes 104 frames.
+; wSilentCryptPulseTimer remembers the frame in VRAM (Silent Crypt and the
+; League rooms, its other users, never share VRAM with Route 39; a stale
+; value only causes one extra upload).
+	ld a, [wMapGroup]
+	cp GROUP_ROUTE_39
+	ret nz
+	ld a, [wMapNumber]
+	cp MAP_ROUTE_39
+	ret nz
+	ld a, [wTileAnimationTimer]
+	and ROUTE39_WINDMILL_FRAMES - 1
+	ld hl, wSilentCryptPulseTimer
+	cp [hl]
+	ret z
+	ld c, a
+; 512 bytes of GDMA take about 2.3 scanlines. Leave the rest of VBlank for
+; OAM; a later windmill slot in the table retries.
+	ldh a, [rLY]
+	cp LY_VBLANK + 3
+	ret nc
+	ld [hl], c
+	ld a, c
+	add a ; frame * $200
+	add HIGH(Route39WindmillFrames)
+	ld h, a
+	ld l, LOW(Route39WindmillFrames)
+	ld a, BANK(vTiles5)
+	ldh [rVBK], a
+	ld de, Route39WindmillRuns
+.run
+	ld a, [de]
+	inc de
+	cp -1
+	jr z, .done
+	ld b, a ; first tile of the run
+	ld a, h
+	ldh [rHDMA1], a
+	ld a, l
+	ldh [rHDMA2], a
+	ld a, b
+	swap a
+	and $0f
+	add HIGH(vTiles5)
+	ldh [rHDMA3], a
+	ld a, b
+	swap a
+	and $f0
+	ldh [rHDMA4], a
+	ld a, [de]
+	inc de
+	ld c, a ; tile count
+	dec a
+	ldh [rHDMA5], a ; general DMA: the CPU waits until it completes
+; hl += count * 16
+	ld a, c
+	swap a
+	ld c, a
+	and $0f
+	ld b, a ; high byte
+	ld a, c
+	and $f0 ; low byte
+	add l
+	ld l, a
+	ld a, b
+	adc h
+	ld h, a
+	jr .run
+
+.done
+	xor a ; AnimateTileset runs us with VRAM bank 0 and restores its caller's bank
+	ldh [rVBK], a
+	ret
+
+	ALIGN 4 ; GDMA sources must be 16-byte aligned
+Route39WindmillFrames:
+INCBIN "gfx/tilesets/route39_windmill.2bpp"
