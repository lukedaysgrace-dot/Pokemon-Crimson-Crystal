+	cp SPRITE_LYRA
+	jr z, .mint
+	cp SPRITE_LYRA_BIKE
+	jr z, .mint
+	cp SPRITE_LYRA_SURF
+	jr z, .mint
+	cp SPRITE_LYRA_SKATEBOARD
+	jr nz, .not_indigo
+
+.mint
+	ld c, PAL_OW_BLUE
+	ret
+
 .not_indigo
