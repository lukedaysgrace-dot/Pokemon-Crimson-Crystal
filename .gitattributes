# Auto detect text files and perform LF normalization
* text eol=lf

# Explicitly declare text files you want to always be normalized and converted
# to native line endings on checkout.

# files part of the build
*.asm text
*.pal text
*.link text
*.txt text

# extra files
*.awk text
*.c text
*.h text
*.md text
*.py text
*.sh text
*.sha1 text

# Denote all files that are truly binary and should not be modified.
*.png binary diff=hex
*.lz.* binary diff=hex
*.bin binary diff=hex
*.blk binary diff=hex
# Polished Map formats. *.blk does NOT glob-match *.ablk, so without these
# lines the "* text eol=lf" rule above strips a CR from any 0D 0A byte pair
# in the map data. That silently deleted one block from TohjoFalls.ablk and
# left it permanently un-committable (it normalized back to the stored blob,
# so every commit came out empty).
*.ablk binary diff=hex
*.gbcpal binary diff=hex
*.dimensions binary diff=hex
*.rle binary diff=hex
*.attrmap binary diff=hex
*.tilemap binary diff=hex

# these are generated but just in case
*.lz binary   diff=hex
*.2bpp binary diff=hex
*.1bpp binary diff=hex

# Archives and compiled binaries. Without these, the "* text eol=lf" rule above
# applies newline normalization to them and silently corrupts the contents.
# The extensionless rgbds/* executables are the important case: they have no
# suffix, so no rule above matched them and they were committed damaged.
*.xz binary
*.gz binary
*.zip binary
*.tar binary
*.dll binary
*.exe binary
*.gbc binary
*.gb binary
*.sym binary
rgbds/rgbasm binary
rgbds/rgblink binary
rgbds/rgbfix binary
rgbds/rgbgfx binary
*.tgz binary
*.gif binary
*.bundle binary
