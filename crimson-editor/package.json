{
  "name": "crimson-editor",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "vite build",
    "preview": "vite preview --host 127.0.0.1",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "extract": "tsx src/extractors/index.ts",
    "validate-data": "tsx src/extractors/index.ts --validate",
    "audit:sprites": "tsx tools/audit-sprites.ts",
    "check:sprites": "tsx tools/prune-sprites.ts",
    "test": "vitest run --config vitest.config.ts",
    "test:ui": "playwright test"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.0",
    "@sveltejs/adapter-static": "^3.0.9",
    "@sveltejs/kit": "^2.48.0",
    "@sveltejs/vite-plugin-svelte": "^6.2.0",
    "@types/node": "^22.0.0",
    "@types/pngjs": "^6.0.5",
    "pngjs": "^7.0.0",
    "prettier": "^3.9.10",
    "prettier-plugin-svelte": "^4.1.1",
    "svelte": "^5.43.0",
    "svelte-check": "^4.3.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "vite": "^7.1.0",
    "vitest": "^3.2.0"
  }
}
