+UnawareStats_Player:
+; Runs right before the held-item boost in the player's damage-stat core.
+; hl = attacking stat ptr, bc = defending stat value, d = move power.
+; - the defender's Unaware ignores the attacker's stat stages: swap hl to
+;   the unmodified stat.
+; - the attacker's Unaware ignores the defender's stat stages: reload bc
+;   from the unmodified defense (re-applying any screen).
+	push de
+	push bc
+	farcall GetOppIgnorableAbility_b
+	ld a, b
+	pop bc
+	cp UNAWARE
+	jr nz, .no_defender_unaware
+	call .SwapToUnboosted
+.no_defender_unaware
+	push bc
+	farcall GetTrueUserAbility_b
+	ld a, b
+	pop bc
+	cp UNAWARE
+	jr nz, .done
+	call .ReloadUnboostedDef
+.done
+	pop de
+	ret
+
+.SwapToUnboosted
+	ld de, .swap_table
+	jp UnawareSwapScan
+
+.swap_table
+	dw wPlayerAttack,  wBattleMonAttack
+	dw wPlayerSpAtk,   wBattleMonSpclAtk
+	dw wPlayerDefense, wBattleMonDefense
+	dw wEnemyAttack,   wEnemyMonAttack
+	dw 0
+
+.ReloadUnboostedDef
+	; special when the attacking stat is a Sp.Atk pointer
+	ld a, h
+	cp HIGH(wPlayerSpAtk)
+	jr nz, .check_raw_spatk
+	ld a, l
+	cp LOW(wPlayerSpAtk)
+	jr z, .special
+.check_raw_spatk
+	ld a, h
+	cp HIGH(wBattleMonSpclAtk)
+	jr nz, .physical
+	ld a, l
+	cp LOW(wBattleMonSpclAtk)
+	jr z, .special
+.physical
+	push hl
+	ld hl, wEnemyMonDefense
+	ld a, [hli]
+	ld b, a
+	ld c, [hl]
+	pop hl
+	ld a, 1 << SCREENS_REFLECT
+	jr .rescreen
+.special
+	push hl
+	ld hl, wEnemyMonSpclDef
+	ld a, [hli]
+	ld b, a
+	ld c, [hl]
+	pop hl
+	ld a, 1 << SCREENS_LIGHT_SCREEN
+.rescreen
+	call CheckDefScreenPierced
+	ret z
+	sla c
+	rl b
+	ret
+
+UnawareStats_Enemy:
+; Enemy-core twin of UnawareStats_Player.
+	push de
+	push bc
+	farcall GetOppIgnorableAbility_b
+	ld a, b
+	pop bc
+	cp UNAWARE
+	jr nz, .no_defender_unaware
+	call .SwapToUnboosted
+.no_defender_unaware
+	push bc
+	farcall GetTrueUserAbility_b
+	ld a, b
+	pop bc
+	cp UNAWARE
+	jr nz, .done
+	call .ReloadUnboostedDef
+.done
+	pop de
+	ret
+
+.SwapToUnboosted
+	ld de, .swap_table
+	jp UnawareSwapScan
+
+.swap_table
+	dw wEnemyAttack,   wEnemyMonAttack
+	dw wEnemySpAtk,    wEnemyMonSpclAtk
+	dw wEnemyDefense,  wEnemyMonDefense
+	dw wPlayerAttack,  wBattleMonAttack
+	dw 0
+
+.ReloadUnboostedDef
+	ld a, h
+	cp HIGH(wEnemySpAtk)
+	jr nz, .check_raw_spatk
+	ld a, l
+	cp LOW(wEnemySpAtk)
+	jr z, .special
+.check_raw_spatk
+	ld a, h
+	cp HIGH(wEnemyMonSpclAtk)
+	jr nz, .physical
+	ld a, l
+	cp LOW(wEnemyMonSpclAtk)
+	jr z, .special
+.physical
+	push hl
+	ld hl, wBattleMonDefense
+	ld a, [hli]
+	ld b, a
+	ld c, [hl]
+	pop hl
+	ld a, 1 << SCREENS_REFLECT
+	jr .rescreen
+.special
+	push hl
+	ld hl, wBattleMonSpclDef
+	ld a, [hli]
+	ld b, a
+	ld c, [hl]
+	pop hl
+	ld a, 1 << SCREENS_LIGHT_SCREEN
+.rescreen
+	call CheckDefScreenPierced
+	ret z
+	sla c
+	rl b
+	ret
+
+UnawareSwapScan:
+; de = table of (boosted ptr, unboosted ptr) pairs, 0-terminated.
+; If hl matches a boosted ptr, replace hl with its unboosted twin.
+	push bc
+.loop
+	ld a, [de]
+	ld c, a
+	inc de
+	ld a, [de]
+	ld b, a
+	inc de
+	or c
+	jr z, .no_match
+	ld a, h
+	cp b
+	jr nz, .next
+	ld a, l
+	cp c
+	jr z, .match
+.next
+	inc de
+	inc de
+	jr .loop
+.match
+	ld a, [de]
+	ld l, a
+	inc de
+	ld a, [de]
+	ld h, a
+.no_match
+	pop bc
+	ret
