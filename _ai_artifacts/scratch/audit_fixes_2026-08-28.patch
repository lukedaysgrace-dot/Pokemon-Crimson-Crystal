diff --git a/tools/battletest/tests/54-audit-2026-08-28.yaml b/tools/battletest/tests/54-audit-2026-08-28.yaml
new file mode 100644
index 0000000..9626658
--- /dev/null
+++ b/tools/battletest/tests/54-audit-2026-08-28.yaml
@@ -0,0 +1,305 @@
+# Regression cases for the 2026-08-28 code audit
+# (_ai_artifacts/reports/CODE_AUDIT_2026-08-28.md). Numbers match the
+# report's findings.
+
+# ---- #1 Spite scans past the move slots after Metronome ---------------------
+
+- name: "Audit 2026-08-28 #1: Spite fails against a Metronome'd move instead of scanning off the moveset"
+  # Electrode is faster: T1 Spite (no last move -> fails), Clefable
+  # Metronomes into some move X. T2 Spite targets X, which is not in
+  # Clefable's slots; the bounded scan must fail the move rather than walk
+  # into party data. Metronome's own PP is the observable: 2 uses = 8.
+  player: { species: CLEFABLE, level: 50, moves: [METRONOME, SPLASH, SPLASH, SPLASH] }
+  enemy:  { species: ELECTRODE, level: 50, moves: [SPITE] }
+  rng: seeded
+  rng_value: 7
+  turns: 2
+  assert:
+    - player.pp[0] == 8
+    - player.pp[1] == 40
+    - player.pp[2] == 40
+    - player.pp[3] == 40
+
+# ---- #2 Enemy U-turn does the full send-out ---------------------------------
+
+- name: "Audit 2026-08-28 #2: enemy U-turn replacement takes hazards and drops stat stages"
+  # Trainer battle. Cloyster lays Spikes first (faster), then Slowpoke
+  # U-turns out: Snorlax must arrive through the normal entrance path -
+  # Spikes damage, fresh stat stages - and must not be Slowpoke again.
+  player:  { species: CLOYSTER, level: 50, moves: [SPIKES] }
+  enemy:   { species: SLOWPOKE, level: 50, stages: { atk: +2 }, moves: [U_TURN] }
+  enemy2:  { species: SNORLAX,  level: 50, moves: [SPLASH] }
+  rng: forced_high
+  turns: 1
+  assert:
+    - enemy.species == 'SNORLAX'
+    - enemy.hp == enemy.maxhp - enemy.maxhp // 8
+    - enemy.stat_levels[0] == 7
+
+# ---- #3 Stealth Rock type scaling ------------------------------------------
+
+- name: "Audit 2026-08-28 #3: Stealth Rock hits a Bug/Flying type for 4x (half its HP)"
+  # (Charizard is Fire/Dragon in this hack, so Butterfree is the 4x case.)
+  player:  { species: TAUROS,     level: 50, ability: RUN_AWAY, moves: [SPLASH] }
