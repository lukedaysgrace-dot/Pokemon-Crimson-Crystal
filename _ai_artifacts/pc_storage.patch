+++ b/home/video.asm
@@ -14,6 +14,32 @@ DMATransfer::
 
 	xor a
 	ldh [hDMATransfer], a
+
+; Optional second transfer (see hram.asm)
+	ldh a, [hDMATransfer2]
+	and a
+	jr z, .done
+	ld c, a
