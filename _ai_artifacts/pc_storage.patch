+	dsprite  2,  2,  1,  0, $0b, PAL_PC_MINI_ICON | VRAM_BANK_1
+	; Mini shadow
+	dsprite  1,  2,  0,  0, $0c, PAL_PC_SHADOW | VRAM_BANK_1
