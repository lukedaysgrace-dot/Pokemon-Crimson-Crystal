+
+; Bill's PC (engine/pc/bills_pc_ui.asm). All tiles live in VRAM bank 1 (vTiles3).
+.OAMData_PcCursor:
+	db 12
+	; Cursor
+	dsprite  0,  0,  0,  0, $04, PAL_PC_CURSOR_MODE1 | VRAM_BANK_1
+	dsprite  0,  0,  1,  0, $04, PAL_PC_CURSOR_MODE2 | VRAM_BANK_1 | X_FLIP
